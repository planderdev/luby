# Copy to .env.local and fill in values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to client
ANTHROPIC_API_KEY=

# Toss Payments (test_ck_/test_sk_ for sandbox, live_ for production)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Supabase service role (server-only) — Settings → API → service_role
# Used ONLY for trusted writes after Toss payment verification
SUPABASE_SERVICE_ROLE_KEY=

# Domain gate — set to luby.im in production only. Enables the old-domain (ruby-ai.kr) 308 redirect.
# Leave empty locally. Do not remove in production.
NEXT_PUBLIC_PRIMARY_DOMAIN=

# Social login buttons to show, comma separated (e.g. google,kakao). Enable the provider in Supabase first.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Toss billing (auto-renew) — "API 개별 연동" keys, separate from the widget keys above.
# Leave empty to hide the auto-renew UI and skip the renewal cron.
NEXT_PUBLIC_TOSS_BILLING_CLIENT_KEY=
TOSS_BILLING_SECRET_KEY=

# Notification email (Resend, server-only)
RESEND_API_KEY=
# Shared secret for DB → app webhooks (x-webhook-secret) and unsubscribe-link signing.
# Must match the value stored in the database webhook functions — rotate with rotate_webhook_secret.
NOTIFICATION_WEBHOOK_SECRET=
# Domains that never receive notification email, comma separated (default: ruby-ai.kr,luby.im)
NOTIFY_SKIP_DOMAINS=

# Web push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@plander.io

# YouTube Data API — channel verification and weekly stats refresh. Optional (falls back to screenshot review).
YOUTUBE_API_KEY=

# Search console ownership meta tags. Optional.
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
